# Senko Assistant Discord-бот — переменные окружения
# Скопируйте в .env и укажите свои значения. Файл .env НЕ коммитится.

# Токен бота из Discord Developer Portal (или уже в Supabase Secrets)
DISCORD_BOT_TOKEN=

# Supabase (тот же адрес, что и у приложения/панели)
SUPABASE_API_URL=https://wcjspwailippjmyffkei.supabase.co/functions/v1/senko
SUPABASE_ANON_KEY=sb_publishable_hsdKNj25gEIXqIxK7Hhr5A_-VberrUG

# Секрет для записи настроек (/settings, /rules) и мониторинга: то же значение, что секрет CRON_SECRET в Supabase
SENKO_BOT_KEY=

# ID каналов Discord (опционально, можно задать через /settings в боте)
DISCORD_CHANNEL_INFO=
DISCORD_CHANNEL_NEWS=
DISCORD_CHANNEL_LAWS=
DISCORD_CHANNEL_ASSISTANTS=
DISCORD_CHANNEL_CHANGELOG=
DISCORD_CHANNEL_SUPPORT=
DISCORD_CHANNEL_MONITOR=
# 3.7: Discord ID владельца — упоминание, если ресурс не отвечает дольше 5 минут (необязательно)
DISCORD_OWNER_ID=

# ID роли «Support» в Discord
DISCORD_ROLE_SUPPORT=
